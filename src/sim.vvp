    %addi 1, 0, 8;
    %assign/vec4 v0x5a2fd5579a20_0, 0;
    %load/vec4 v0x5a2fd5579a20_0;
    %load/vec4 v0x5a2fd5579b00_0;
    %cmp/u;
    %flag_mov 8, 5;
    %jmp/0 T_0.2, 8;
    %pushi/vec4 1, 0, 1;
    %jmp/1 T_0.3, 8;
T_0.2 ; End of true expr.
